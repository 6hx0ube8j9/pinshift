#include <windows.h>
#include "resource.h"

1 24 "manifest.xml"

IDI_APP_ICON    ICON "res/app.ico"
IDI_ICON_QUAN   ICON "res/quan.ico"
IDI_ICON_SHUANG ICON "res/shuang.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PinSwitch Project"
            VALUE "FileDescription",  "PinSwitch Input Method Switcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "pinswitch"
            VALUE "LegalCopyright",   "Copyright (c) PinSwitch Project"
            VALUE "OriginalFilename", "pinswitch.exe"
            VALUE "ProductName",      "PinSwitch"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
